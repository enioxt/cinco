    {
      "id": "mcp",
      "nome": "Conector MCP público",
      "para_quem": "qualquer IA que fala MCP: Claude, ChatGPT, Codex, Cursor, Gemini CLI, OpenAI Agents SDK",
      "como": [
        "URL: https://mcp.egos.ia.br/publico/mcp (Streamable HTTP, sem token)",
        "claude mcp add --transport http --scope user egos https://mcp.egos.ia.br/publico/mcp",
        "codex mcp add egos --url https://mcp.egos.ia.br/publico/mcp"
      ],
      "url": "https://egos.ia.br/#/instalar",
      "estado": "no-ar"
    },
    {
      "id": "plugin-claude-code",
      "nome": "Plugin \"egos\" do Claude Code (v0.1.0)",
      "para_quem": "quem usa Claude Code",
      "como": [
        "claude plugin marketplace add https://egos.ia.br/plugins/marketplace.json && claude plugin install egos@egos"
      ],
      "url": "https://egos.ia.br/plugins/marketplace.json",
      "estado": "no-ar"
    },
    {
      "id": "npm",
